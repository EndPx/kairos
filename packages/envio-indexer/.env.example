# Obtain a free HyperSync API token from https://envio.dev/app/api-tokens.
ENVIO_API_TOKEN=

# Fill these only after a KairosPolicy deployment is confirmed on Monad Testnet.
ENVIO_KAIROS_POLICY_ADDRESS=
