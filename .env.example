ENVIO_GRAPHQL_ADMIN_SECRET=

# CRE deployment identity and public receiver configuration
CRE_FORWARDER_ADDRESS=
CRE_WORKFLOW_ID=
CRE_WORKFLOW_NAME=
CRE_WORKFLOW_OWNER=

# Server-only credentials. Do not expose these with NEXT_PUBLIC_ prefixes.
CRE_API_KEY=
AURORA_API_KEY=
AURORA_SOURCE_BLOCKCHAIN=
AURORA_SOURCE_ASSET_ID=
KAIROS_DEPLOYER_PRIVATE_KEY=
